.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env

# Keep example file (this one SHOULD be committed)
!.env.example
!*.env.example

# ────────────────────────────────────────────
# 🗄️ Database Files
# ────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
compliance.db
db/compliance.db

# ────────────────────────────────────────────
# 🧠 AI / ML / Vector DB Specific
# ────────────────────────────────────────────

# ChromaDB
chroma_db/
chroma.sqlite3
.data/
data/chroma_db/
backend/data/chroma_db/

# FAISS
*.faiss
*.index
*.pkl

# Model weights (if any)
models/
weights/
*.h5
*.pth
*.pt
*.ckpt
*.safetensors
*.bin

# HuggingFace cache
.cache/huggingface/
huggingface/

# Embeddings cache
embeddings/
*.embedding
*.emb

# ────────────────────────────────────────────
# 📁 Uploaded / User Data
# ────────────────────────────────────────────
backend/data/uploads/
backend/data/documents/
uploads/
media/
*.pdf
*.docx
*.doc
*.xlsx
*.csv

# But keep sample data (important!)
!samples/**
!backend/data/documents/**/*.md
!backend/data/documents/**/*.txt

# ────────────────────────────────────────────
# 📄 Generated Reports
# ────────────────────────────────────────────
reports/
*.report
generated_reports/
backend/reports


# ============================================
# AI Compliance Investigator - .gitignore
